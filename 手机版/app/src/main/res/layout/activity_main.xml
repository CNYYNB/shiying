<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Hidden WebView fallback lives here, underneath the opaque content. -->
    <FrameLayout android:id="@+id/webHolder" android:layout_width="match_parent" android:layout_height="match_parent"/>

    <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/bg" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingBottom="28dp">

            <!-- top bar -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="拾影" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/red"/>
                <TextView android:id="@+id/btnLogin" android:layout_width="wrap_content" android:layout_height="36dp"
                    android:gravity="center" android:paddingLeft="12dp" android:paddingRight="12dp" android:text="登录"
                    android:textSize="14sp" android:textColor="@color/red" android:background="@drawable/btn_outline"/>
                <TextView android:id="@+id/btnMore" android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_marginStart="6dp" android:gravity="center" android:text="⋮" android:textSize="22sp"
                    android:textColor="@color/text" android:contentDescription="更多"
                    android:background="?android:attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>

            <TextView android:id="@+id/updateBanner" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" android:padding="12dp" android:background="@drawable/card"
                android:textColor="@color/red" android:textSize="14sp" android:textStyle="bold" android:visibility="gone"/>

            <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="96dp" android:maxLines="6" android:gravity="top|start" android:padding="14dp"
                android:background="@drawable/input" android:textSize="15sp" android:textColor="@color/text"
                android:textColorHint="@color/text2" android:inputType="textMultiLine|textNoSuggestions"
                android:hint="粘贴分享链接或整段分享口令&#10;支持抖音 快手 小红书 B站 微博 头条 YouTube TikTok Instagram X Facebook Vimeo" android:importantForAutofill="no"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <TextView android:id="@+id/btnPaste" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
                    android:gravity="center" android:text="粘贴" android:textSize="16sp" android:textColor="@color/red"
                    android:background="@drawable/btn_outline"/>
                <TextView android:id="@+id/btnClear" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp"
                    android:layout_marginStart="10dp" android:gravity="center" android:text="清空" android:textSize="16sp"
                    android:textColor="@color/red" android:background="@drawable/btn_outline"/>
                <TextView android:id="@+id/btnParse" android:layout_width="0dp" android:layout_weight="2" android:layout_height="50dp"
                    android:layout_marginStart="10dp" android:gravity="center" android:text="解析" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/on_red" android:background="@drawable/btn_red"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
                <ProgressBar android:id="@+id/parseSpin" android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_marginEnd="8dp" android:indeterminateTint="@color/red" android:visibility="gone"/>
                <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/text2"
                    android:textIsSelectable="true"/>
            </LinearLayout>
            <TextView android:id="@+id/btnWebMode" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="8dp" android:gravity="center" android:text="用网页模式重试（可登录 / 完成验证）"
                android:textSize="15sp" android:textColor="@color/red" android:background="@drawable/btn_outline"
                android:visibility="gone"/>

            <!-- preview -->
            <LinearLayout android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="vertical" android:background="@drawable/card"
                android:padding="12dp" android:visibility="gone">
                <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="220dp"
                    android:scaleType="centerCrop" android:background="@color/border" android:contentDescription="封面"/>
                <TextView android:id="@+id/pTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text"
                    android:maxLines="3" android:ellipsize="end"/>
                <TextView android:id="@+id/pMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="14sp" android:textColor="@color/text2"/>
                <TextView android:id="@+id/pQuality" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textSize="14sp"
                    android:textColor="@color/red" android:visibility="gone"/>
                <TextView android:id="@+id/btnDownload" android:layout_width="match_parent" android:layout_height="54dp"
                    android:layout_marginTop="12dp" android:gravity="center" android:text="下载视频（无水印）"
                    android:textSize="17sp" android:textStyle="bold" android:textColor="@color/on_red" android:background="@drawable/btn_red"/>
                <ProgressBar android:id="@+id/dlBar" style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp"
                    android:max="100" android:progressDrawable="@drawable/progress_red" android:visibility="gone"/>
                <TextView android:id="@+id/dlText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="@color/text2" android:visibility="gone"/>
            </LinearLayout>

            <!-- history -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="下载记录" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text"/>
                <TextView android:id="@+id/btnClearHistory" android:layout_width="wrap_content" android:layout_height="34dp"
                    android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp" android:text="清空记录" android:textSize="14sp"
                    android:textColor="@color/text2" android:background="?android:attr/selectableItemBackground"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/historyList" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <TextView android:id="@+id/historyEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="18dp" android:paddingBottom="18dp" android:gravity="center" android:text="还没有下载记录"
                android:textSize="14sp" android:textColor="@color/text2"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
