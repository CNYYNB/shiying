<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/card" android:padding="10dp">
    <ImageView android:id="@+id/hCover" android:layout_width="54dp" android:layout_height="72dp"
        android:scaleType="centerCrop" android:background="@color/border" android:contentDescription="封面"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:orientation="vertical">
        <TextView android:id="@+id/hTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="@color/text" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/hMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/text2" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/hStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
